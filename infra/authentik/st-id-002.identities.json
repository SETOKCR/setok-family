      "authentik_core.change_user",
      "authentik_core.reset_user_password"
    ],
    "tokenIntent": "api",
    "tokenLifetimeMinutes": 60,
    "revokedAtEndOfEveryRun": true
  },
  "apiEndpoint": "https://192.168.89.22:9443 (LAN only, self-signed foundation certificate)"
